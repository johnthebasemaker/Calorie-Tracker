# Copy to android/keystore.properties and fill in, after creating the upload
# key. That file is gitignored; this example is not, so the shape of it stays
# in the repo. See RELEASE.md for the keytool command that creates the key.
#
# storeFile is resolved relative to the android/ directory.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
